# Arker Configuration
# Copy this file to .env and modify the values as needed

# Database Configuration
DB_URL=host=localhost user=user password=pass dbname=arker port=5432 sslmode=disable

# Storage Configuration
STORAGE_PATH=./storage
CACHE_PATH=./cache

# Server Configuration
PORT=8080
MAX_WORKERS=5

# Authentication Configuration
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
LOGIN_TEXT=

# Storage Backend Configuration
# Options: "filesystem" or "s3"
STORAGE_TYPE=filesystem

# S3 Configuration (only used when STORAGE_TYPE=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=
S3_FORCE_PATH_STYLE=false
S3_TEMP_DIR=/tmp

# Itch.io Configuration
ITCH_API_KEY=
ITCH_DL_PATH=itch-dl

# Production Canaries (see docs/canaries.md)
# Empty CANARY_SCHEDULE = disabled; nothing recurring runs. Set it to a Go
# duration (minimum 15m; "6h" recommended) to activate. Manual sweeps via
# POST /admin/canaries/run work either way and are always free.
CANARY_SCHEDULE=
# Comma-separated probe keys; empty = every default-enabled probe.
CANARY_PROBES=
# Per-probe URL overrides for rotation, e.g.:
# CANARY_PROBE_URL_VIMEO_VIDEO=https://vimeo.com/...
# Paid probes are a separate opt-in and are NOT needed to enable canaries.
CANARY_ALLOW_PAID_FALLBACK=false
CANARY_MAX_COST_USD_PER_RUN=0.25
CANARY_MAX_COST_USD_PER_DAY=1.00
